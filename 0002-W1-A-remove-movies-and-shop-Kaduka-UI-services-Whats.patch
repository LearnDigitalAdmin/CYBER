-
-    const errorMsg =
-      session.language === 'en'
-        ? `❌ An error occurred: ${error.message}\n\nPlease try again.`
-        : `❌ Hitilafu iliotokea: ${error.message}\n\nTafadhali jaribu tena.`;
-
-    return errorMsg;
-  }
