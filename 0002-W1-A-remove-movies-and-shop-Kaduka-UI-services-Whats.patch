-      logger.error('❌ CRITICAL: No reference returned from charge initiation', {
-        phone,
-        shopId,
-      });
-
-      const errorMsg =
-        session.language === 'en'
-          ? '❌ Error: Payment request did not receive a tracking reference. Please try again.'
