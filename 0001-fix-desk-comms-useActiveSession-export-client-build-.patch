From: desk-final-patch <patch@local>
Date: Mon, 12 Oct 2026 01:43:33 +0000
Subject: [PATCH] fix(desk): comms useActiveSession export (client build),
 chama lookup field publicCode, CORS for samuhia origins

---
 cors.json                                     | 20 +++++++++++++++----
 .../src/connectors/connectors.emu.test.ts     |  6 +++---
 functions-desk/src/connectors/deskOwner.ts    |  5 ++---
 src/desk/modules/comms/lib/access.ts          |  3 ++-
 4 files changed, 23 insertions(+), 11 deletions(-)

diff --git a/cors.json b/cors.json
index 8921b79..2db73d8 100644
--- a/cors.json
+++ b/cors.json
@@ -3,10 +3,22 @@
     "origin": [
       "https://cyber.cogvana.co.ke",
       "https://cogvana.co.ke",
-      "https://www.cogvana.co.ke"
+      "https://www.cogvana.co.ke",
+      "https://cyber.samuhia.co.ke",
+      "https://samuhia.co.ke",
+      "https://www.samuhia.co.ke"
+    ],
+    "method": [
+      "GET",
+      "HEAD",
+      "PUT",
+      "POST",
+      "DELETE"
+    ],
+    "responseHeader": [
+      "Content-Type",
+      "x-goog-meta-*"
     ],
-    "method": ["GET", "HEAD", "PUT", "POST", "DELETE"],
-    "responseHeader": ["Content-Type", "x-goog-meta-*"],
     "maxAgeSeconds": 3600
   }
-]
\ No newline at end of file
+]
diff --git a/functions-desk/src/connectors/connectors.emu.test.ts b/functions-desk/src/connectors/connectors.emu.test.ts
index 36c197d..0ceba29 100644
--- a/functions-desk/src/connectors/connectors.emu.test.ts
+++ b/functions-desk/src/connectors/connectors.emu.test.ts
@@ -109,7 +109,7 @@ test("incomplete bank details are reported, not guessed", opts, async () => {
 });
 test("sync writes deskOwner on every chama this desk owns, using the chama subaccount", opts, async () => {
   chamaSeparate();
-  for (const [id, code] of [["c1", "SMC-0001"], ["c2", "SMC-0002"], ["c3", "SMC-0003"]]) await h.chama.collection("chamas").doc(id).set({ code });
+  for (const [id, code] of [["c1", "SMC-0001"], ["c2", "SMC-0002"], ["c3", "SMC-0003"]]) await h.chama.collection("chamas").doc(id).set({ publicCode: code });
   for (const code of ["SMC-0001", "SMC-0002"]) await col("customers").doc(`chama:${code}`).set({ entityKey: `chama:${code}`, product: "chama", ownerAgentId: "1", attributedAt: 1, firstPurchaseUsed: false, paidPeriods: [] });
   await col("customers").doc("chama:SMC-0003").set({ entityKey: "chama:SMC-0003", product: "chama", ownerAgentId: "other", attributedAt: 1, firstPurchaseUsed: false, paidPeriods: [] });
   await syncPayoutAccounts(h.deps, "1");
@@ -119,7 +119,7 @@ test("sync writes deskOwner on every chama this desk owns, using the chama subac
 });
 test("writeDeskOwner writes nothing when the account is not ready, with the reason", opts, async () => {
   chamaSeparate();
-  await h.chama.collection("chamas").doc("c1").set({ code: "SMC-0001" });
+  await h.chama.collection("chamas").doc("c1").set({ publicCode: "SMC-0001" });
   await col("customers").doc(KEY).set({ entityKey: KEY, product: "chama", ownerAgentId: "1", attributedAt: 1, firstPurchaseUsed: false, paidPeriods: [] });
   const agent = (await col("agents").doc("1").get()).data() as AgentDoc;
   const r = await writeDeskOwner(h.deps, h.state.cfg, agent, "SMC-0001");
@@ -127,7 +127,7 @@ test("writeDeskOwner writes nothing when the account is not ready, with the reas
   assert.equal((await h.chama.collection("chamas").doc("c1").get()).data()?.deskOwner, undefined);
 });
 test("writeDeskOwner refuses a chama this desk does not own", opts, async () => {
-  await h.chama.collection("chamas").doc("c1").set({ code: "SMC-0001" });
+  await h.chama.collection("chamas").doc("c1").set({ publicCode: "SMC-0001" });
   const agent = (await col("agents").doc("1").get()).data() as AgentDoc;
   assert.equal((await writeDeskOwner(h.deps, h.state.cfg, agent, "SMC-0001")).written, false);
 });
diff --git a/functions-desk/src/connectors/deskOwner.ts b/functions-desk/src/connectors/deskOwner.ts
index 4bde6ff..1eb0433 100644
--- a/functions-desk/src/connectors/deskOwner.ts
+++ b/functions-desk/src/connectors/deskOwner.ts
@@ -12,10 +12,9 @@ import type { Deps } from "./deps.js";
 /** Chama collection holding chama documents (functions/shared/constants.py: MC.CHAMAS). */
 export const CHAMA_COLLECTION = "chamas";
 /**
- * Field on a chama document that holds its public SMC-… code. The current Chama repo has no such field yet (the SMC code
- * scheme is delivered by Chama's own patch), so this is the single place to change if that patch names it differently.
+ * Field on a chama document that holds its public SMC-… code (Chama stores it as `publicCode`; see Chama functions/shared/desk_codes.py).
  */
-export const CHAMA_CODE_FIELD = "code";
+export const CHAMA_CODE_FIELD = "publicCode";
 
 export interface DeskOwnerResult { written: boolean; reason?: string }
 
diff --git a/src/desk/modules/comms/lib/access.ts b/src/desk/modules/comms/lib/access.ts
index b2c9e7a..0d19aac 100644
--- a/src/desk/modules/comms/lib/access.ts
+++ b/src/desk/modules/comms/lib/access.ts
@@ -4,4 +4,5 @@
  *   useActiveSession(): { sessionId: string | null; entityKey: string | null }   (sessionStorage)
  * Comms, Reports and Rent are shared consumers of this folder; if W1-D ever moves these, fix it here only.
  */
-export { ActionOtpDialog, useActiveSession } from "../../../access/ActionOtpDialog";
+export { ActionOtpDialog } from "../../../access/ActionOtpDialog";
+export { useActiveSession } from "../../../access/useActiveSession";
