+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { DEFAULT_DESK_CONFIG } from "../config.js";
+import { DEAD_PAYSTACK_STATUSES } from "../charge/port.js";
+import { aggregateEarnings } from "./earnings.js";
+import { decideTicket, planSettlement } from "./plan.js";
+import { shouldProcessTransactionChange } from "./trigger.js";
+
+const cfg = DEFAULT_DESK_CONFIG;
+
+test("settlement uses Paystack's real fee and the stored share: agent 97.5% of (gross - fee)", () => {
+  const p = planSettlement({ amountMinor: 20000, sharePct: 97.5 }, { amountMinor: 20000, feesMinor: 300, currency: "KES" }, cfg);
+  assert.ok(p.ok);
+  if (p.ok) { assert.equal(p.agentMinor, 19207); assert.equal(p.platformMinor, 493); assert.equal(p.agentMinor + p.platformMinor, 19700); assert.equal(p.feeMinor, 300); }
+});
+test("share defaults to the configured service plan when the ticket has none", () => {
+  const p = planSettlement({ amountMinor: 10000 }, { amountMinor: 10000, feesMinor: 0 }, cfg);
+  assert.ok(p.ok && p.sharePct === 97.5 && p.agentMinor === 9750);
+});
+test("amount or currency mismatch -> not ok, never settles", () => {
+  assert.deepEqual(planSettlement({ amountMinor: 20000 }, { amountMinor: 19999, feesMinor: 0 }, cfg), { ok: false, reason: "amount mismatch" });
+  assert.deepEqual(planSettlement({ amountMinor: 20000 }, { amountMinor: 20000, feesMinor: 0, currency: "NGN" }, cfg), { ok: false, reason: "amount mismatch" });
+});
+test("an impossible fee is an error, not a settlement", () => {
+  assert.throws(() => planSettlement({ amountMinor: 100 }, { amountMinor: 100, feesMinor: 101 }, cfg), /invalid fee/);
+});
+
+test("reconciler decisions: any success settles; latest dead fails; pending ages into expiry", () => {
+  const D = DEAD_PAYSTACK_STATUSES;
+  assert.deepEqual(decideTicket([{ ref: "a", status: "pending" }, { ref: "b", status: "failed" }], 0, D), { action: "fail", reason: "Payment was not completed" });
+  assert.deepEqual(decideTicket([{ ref: "a", status: "success" }, { ref: "b", status: "failed" }], 0, D), { action: "settle", ref: "a" });
+  assert.deepEqual(decideTicket([{ ref: "a", status: "failed", reason: " Insufficient funds " }], 0, D), { action: "fail", reason: "Insufficient funds" });
+  assert.deepEqual(decideTicket([{ ref: "a", status: "pending" }], 14 * 60_000, D), { action: "wait" });
+  assert.deepEqual(decideTicket([{ ref: "a", status: "pending" }], 15 * 60_000, D), { action: "expire" });
+  assert.deepEqual(decideTicket([{ ref: "a", status: "not_found" }], 16 * 60_000, D), { action: "expire" });
+});
+
+test("trigger filter: desk charges only; success always, failure only on change", () => {
+  const ref = "CYBER_DSK_T1_1";
+  assert.equal(shouldProcessTransactionChange("CYBER_u1_123", undefined, { status: "success", deskTicketId: "T1" }), false);
+  assert.equal(shouldProcessTransactionChange(ref, undefined, { status: "success" }), false);
+  assert.equal(shouldProcessTransactionChange(ref, { status: "pending" }, { status: "success", deskTicketId: "T1" }), true);
+  assert.equal(shouldProcessTransactionChange(ref, { status: "success", deskTicketId: "T1" }, { status: "success", deskTicketId: "T1" }), true);
+  assert.equal(shouldProcessTransactionChange(ref, { status: "pending", deskTicketId: "T1" }, { status: "failed", deskTicketId: "T1" }), true);
+  assert.equal(shouldProcessTransactionChange(ref, { status: "failed", deskTicketId: "T1" }, { status: "failed", deskTicketId: "T1" }), false);
+  assert.equal(shouldProcessTransactionChange(ref, undefined, { status: "pay_offline", deskTicketId: "T1" }), false);
+  assert.equal(shouldProcessTransactionChange(ref, { status: "success", deskTicketId: "T1" }, undefined), false);
+});
+
+test("earnings: by status and stream; void ignored; processing counts as unpaid; reversals net out", () => {
+  const t = aggregateEarnings([
+    { kind: "service", status: "settled", amountMinor: 19000 },
+    { kind: "commission", status: "settled", amountMinor: 5000, product: "chama" },
+    { kind: "reversal", status: "settled", amountMinor: -5000, product: "chama" },
+    { kind: "reversal", status: "settled", amountMinor: -1000 },
+    { kind: "bonus", status: "payable", amountMinor: 200000 },
+    { kind: "bonus", status: "processing", amountMinor: 200000 },
+    { kind: "bonus", status: "paid", amountMinor: 200000 },
+    { kind: "bonus", status: "void", amountMinor: 200000 },
+    { kind: "support", status: "payable", amountMinor: 3000 },
+  ]);
+  assert.equal(t.settledMinor, 18000);
+  assert.equal(t.payableMinor, 403000);
+  assert.equal(t.paidMinor, 200000);
+  assert.deepEqual(t.byProduct, [
+    { product: "service", amountMinor: 18000 }, { product: "chama", amountMinor: 0 },
+    { product: "bonus", amountMinor: 600000 }, { product: "support", amountMinor: 3000 },
+  ]);
+});
diff --git a/functions-desk/src/ledger/plan.ts b/functions-desk/src/ledger/plan.ts
new file mode 100644
index 0000000..d01dd49
--- /dev/null
+++ b/functions-desk/src/ledger/plan.ts
@@ -0,0 +1,43 @@
+/** Pure settlement planning for a desk service ticket, from Paystack's VERIFIED figures (never from the webhook document). */
+import type { DeskConfig } from "../config.js";
+import { DeskError } from "../errors.js";
+import { servicePlan, settledAmounts } from "../money.js";
+import type { DeskTicket } from "../tickets/model.js";
+
+export const AMOUNT_MISMATCH = "amount mismatch";
+
+export interface VerifiedFigures { amountMinor: number; feesMinor: number; currency?: string }
+export type SettlementPlan =
+  | { ok: true; grossMinor: number; feeMinor: number; agentMinor: number; platformMinor: number; sharePct: number }
+  | { ok: false; reason: typeof AMOUNT_MISMATCH };
+
+export function planSettlement(t: Pick<DeskTicket, "amountMinor" | "sharePct">, v: VerifiedFigures, cfg: DeskConfig): SettlementPlan {
+  if (v.amountMinor !== t.amountMinor || (v.currency !== undefined && v.currency.toUpperCase() !== "KES"))
+    return { ok: false, reason: AMOUNT_MISMATCH };
+  if (!Number.isSafeInteger(v.feesMinor) || v.feesMinor < 0 || v.feesMinor > v.amountMinor)
+    throw new DeskError("internal", "Paystack reported an invalid fee for this payment");
+  const sharePct = t.sharePct ?? servicePlan(cfg).agentSharePct;
+  const s = settledAmounts({ grossMinor: v.amountMinor, feeMinor: v.feesMinor, agentSharePct: sharePct });
+  return { ok: true, grossMinor: v.amountMinor, feeMinor: v.feesMinor, agentMinor: s.agentMinor, platformMinor: s.platformMinor, sharePct };
+}
+
+export type AttemptStatus = { ref: string; status: string; reason?: string };
+export type TicketDecision =
+  | { action: "settle"; ref: string }
+  | { action: "fail"; reason: string }
+  | { action: "expire" }
+  | { action: "wait" };
+
+export const PENDING_EXPIRY_MS = 15 * 60_000;
+
+/**
+ * What the reconciler does with an awaiting_payment ticket. `attempts` is ordered oldest -> newest and holds Paystack's
+ * verified status per reference ("not_found" when Paystack has never seen it). A success on ANY attempt settles the ticket
+ * (money first); otherwise the latest attempt decides.
+ */
+export function decideTicket(attempts: readonly AttemptStatus[], ageMs: number, deadStatuses: ReadonlySet<string>): TicketDecision {
+  for (let i = attempts.length - 1; i >= 0; i--) if (attempts[i].status === "success") return { action: "settle", ref: attempts[i].ref };
+  const latest = attempts[attempts.length - 1];
+  if (latest && deadStatuses.has(latest.status)) return { action: "fail", reason: latest.reason?.trim() || "Payment was not completed" };
+  return ageMs >= PENDING_EXPIRY_MS ? { action: "expire" } : { action: "wait" };
+}
diff --git a/functions-desk/src/ledger/reconcile.ts b/functions-desk/src/ledger/reconcile.ts
new file mode 100644
index 0000000..864eb5d
--- /dev/null
+++ b/functions-desk/src/ledger/reconcile.ts
@@ -0,0 +1,109 @@
+/**
+ * desk_reconcileTickets — recovers what the webhook trigger missed and clears what can never complete. At most 100 tickets per run.
+ *   awaiting_payment older than 3 min : verify with Paystack -> paid (same settle path) / failed; pending > 15 min -> expired
+ *   draft older than 24 h             : expired (its saved draft chunks are deleted)
+ */
+import * as logger from "firebase-functions/logger";
+import { DEAD_PAYSTACK_STATUSES, isReferenceNotFound, resolveDeps, type DeskDeps } from "../charge/port.js";
+import { MAX_CHARGE_ATTEMPTS } from "../charge/chargeTicket.js";
+import { col, db } from "../db.js";
+import { audit } from "../kernel/audit.js";
+import { isSettled, type DeskTicket } from "../tickets/model.js";
+import { decideTicket, type AttemptStatus } from "./plan.js";
+import { failTicketAttempt, settleTicketReference } from "./settle.js";
+
+export const RECONCILE_MAX_PER_RUN = 100;
+export const AWAITING_MIN_AGE_MS = 3 * 60_000;
+export const DRAFT_MAX_AGE_MS = 24 * 3_600_000;
+
+export interface ReconcileSummary { checked: number; paid: number; failed: number; expired: number; draftsExpired: number; waiting: number; errors: number }
+
+async function expireTicket(ticketId: string, expected: "awaiting_payment" | "draft", reason: string, d: ReturnType<typeof resolveDeps>): Promise<DeskTicket | undefined> {
+  const ref = col("tickets").doc(ticketId);
+  const cutoff = d.now() - (expected === "draft" ? DRAFT_MAX_AGE_MS : AWAITING_MIN_AGE_MS);
+  return db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref);
+    const t = snap.data() as DeskTicket | undefined;
+    if (!t || t.status !== expected || t.updatedAt >= cutoff) return undefined;
+    tx.update(ref, { status: "expired", failureReason: reason, updatedAt: d.now() });
+    return t;
+  });
+}
+
+async function deleteDraftChunks(ticketId: string): Promise<void> {
+  const chunks = await col("tickets").doc(ticketId).collection("draft").get();
+  if (chunks.empty) return;
+  const batch = db().batch();
+  for (const c of chunks.docs) batch.delete(c.ref);
+  await batch.commit();
+}
+
+async function reconcileAwaiting(t: DeskTicket, d: ReturnType<typeof resolveDeps>, s: ReconcileSummary): Promise<void> {
+  const refs = [...(t.attemptRefs ?? (t.paystackRef ? [t.paystackRef] : []))].slice(-MAX_CHARGE_ATTEMPTS);
+  const attempts: AttemptStatus[] = [];
+  let unreadable = false;
+  for (const ref of refs) {
+    try {
+      const v = await d.port.verifyTransaction(ref);
+      const reason = typeof v.raw.gateway_response === "string" ? v.raw.gateway_response : undefined;
+      attempts.push({ ref, status: v.status, reason });
+      if (v.status === "success") {
+        const out = await settleTicketReference({ ticketId: t.ticketId, reference: ref, source: "reconciler", verified: v }, d);
+        if (out.kind === "paid" || out.kind === "mismatch") { s[out.kind === "paid" ? "paid" : "failed"]++; return; }
+        return;
+      }
+    } catch (err) {
+      if (isReferenceNotFound(err)) attempts.push({ ref, status: "not_found" });
+      else { unreadable = true; logger.warn("reconcile: could not verify", { ticketId: t.ticketId, ref }); }
+    }
+  }
+  if (unreadable) { s.errors++; return; } // never expire or fail on a transient Paystack error
+  const age = d.now() - (t.chargeStartedAt ?? t.updatedAt);
+  const decision = decideTicket(attempts, age, DEAD_PAYSTACK_STATUSES);
+  if (decision.action === "fail") {
+    const live = t.paystackRef;
+    if (live && (await failTicketAttempt({ ticketId: t.ticketId, reference: live, reason: decision.reason, source: "reconciler" }, d))) s.failed++;
+  } else if (decision.action === "expire") {
+    const done = await expireTicket(t.ticketId, "awaiting_payment", "Payment was not completed in time", d);
+    if (done) {
+      s.expired++;
+      await audit({ action: "ticket_expired", agentId: done.agentId, entityKey: done.entityKey, meta: { ticketId: done.ticketId, was: "awaiting_payment", source: "reconciler" } });
+    }
+  } else {
+    s.waiting++;
+  }
+}
+
+export async function reconcileTickets(deps: DeskDeps = {}): Promise<ReconcileSummary> {
+  const d = resolveDeps(deps);
+  const s: ReconcileSummary = { checked: 0, paid: 0, failed: 0, expired: 0, draftsExpired: 0, waiting: 0, errors: 0 };
+  let budget = RECONCILE_MAX_PER_RUN;
+
+  const awaiting = await col("tickets").where("status", "==", "awaiting_payment")
+    .where("updatedAt", "<", d.now() - AWAITING_MIN_AGE_MS).orderBy("updatedAt", "asc").limit(budget).get();
+  for (const doc of awaiting.docs) {
+    budget--; s.checked++;
+    const t = doc.data() as DeskTicket;
+    try { if (!isSettled(t.status)) await reconcileAwaiting(t, d, s); }
+    catch (err) { s.errors++; logger.error("reconcile: ticket failed", { ticketId: t.ticketId, err }); }
+  }
+
+  if (budget > 0) {
+    const drafts = await col("tickets").where("status", "==", "draft")
+      .where("updatedAt", "<", d.now() - DRAFT_MAX_AGE_MS).orderBy("updatedAt", "asc").limit(budget).get();
+    for (const doc of drafts.docs) {
+      s.checked++;
+      const t = doc.data() as DeskTicket;
+      try {
+        const done = await expireTicket(t.ticketId, "draft", "Draft expired after 24 hours", d);
+        if (done) {
+          await deleteDraftChunks(t.ticketId);
+          s.draftsExpired++;
+          await audit({ action: "ticket_expired", agentId: done.agentId, entityKey: done.entityKey, meta: { ticketId: done.ticketId, was: "draft", source: "reconciler" } });
+        }
+      } catch (err) { s.errors++; logger.error("reconcile: draft expiry failed", { ticketId: t.ticketId, err }); }
+    }
+  }
+  logger.info("desk_reconcileTickets", s);
+  return s;
+}
diff --git a/functions-desk/src/ledger/settle.ts b/functions-desk/src/ledger/settle.ts
new file mode 100644
index 0000000..10d82f6
--- /dev/null
+++ b/functions-desk/src/ledger/settle.ts
@@ -0,0 +1,135 @@
+/**
+ * The single code path that turns a CONFIRMED Paystack payment into a paid desk ticket. Used by the webhook trigger, the
+ * reconciler and the re-prompt check, so all three behave identically:
+ *   - Paystack is asked (verifyTransaction); the cyber-transactions document is never trusted on its own.
+ *   - success + amount equal to the ticket -> one transaction sets the ticket paid and writes ONE service ledger row.
+ *   - a replay changes nothing; a second payment on an already-paid ticket is flagged for refund, never double-counted.
+ *   - amount mismatch -> ticket failed ("amount mismatch"), audited, no ledger row.
+ */
+import { FieldValue } from "firebase-admin/firestore";
+import { parseDeskReference } from "../charge/reference.js";
+import { resolveDeps, type DeskDeps } from "../charge/port.js";
+import { col, db } from "../db.js";
+import { audit } from "../kernel/audit.js";
+import type { VerifiedTransaction } from "../paystack/client.js";
+import { isSettled, type DeskTicket } from "../tickets/model.js";
+import { AMOUNT_MISMATCH, planSettlement } from "./plan.js";
+import { buildLedgerDoc, ledgerRef } from "./txLedger.js";
+import { ledgerEntryId } from "../kernel/ledger.js";
+
+export type SettleSource = "webhook" | "reconciler" | "reprompt";
+export type SettleOutcome =
+  | { kind: "paid"; changed: boolean }
+  | { kind: "duplicate"; changed: boolean }
+  | { kind: "mismatch"; changed: boolean }
+  | { kind: "not_success"; status: string }
+  | { kind: "missing_ticket" }
+  | { kind: "wrong_ticket" };
+
+export async function settleTicketReference(
+  args: { ticketId: string; reference: string; source: SettleSource; verified?: VerifiedTransaction },
+  deps: DeskDeps = {},
+): Promise<SettleOutcome> {
+  const d = resolveDeps(deps);
+  const { ticketId, reference, source } = args;
+  const ticketRef = col("tickets").doc(ticketId);
+
+  const parsed = parseDeskReference(reference);
+  if (!parsed || parsed.ticketId !== ticketId) {
+    await audit({ action: "ticket_reference_rejected", meta: { ticketId, reference, source } });
+    return { kind: "wrong_ticket" };
+  }
+  const pre = await ticketRef.get();
+  if (!pre.exists) {
+    await audit({ action: "ticket_settle_orphan", meta: { ticketId, reference, source } });
+    return { kind: "missing_ticket" };
+  }
+  const first = pre.data() as DeskTicket;
+  if (isSettled(first.status) && first.paystackRef === reference) return { kind: "paid", changed: false };
+
+  const v = args.verified ?? await d.port.verifyTransaction(reference);
+  if (v.status !== "success") return { kind: "not_success", status: v.status };
+
+  const cfg = await d.config();
+  const currency = typeof v.raw.currency === "string" ? v.raw.currency : undefined;
+  const plan = planSettlement(first, { amountMinor: v.amountMinor, feesMinor: v.feesMinor, currency }, cfg);
+  const now = d.now();
+
+  const result = await db().runTransaction(async (tx): Promise<SettleOutcome> => {
+    const snap = await tx.get(ticketRef);
+    if (!snap.exists) return { kind: "missing_ticket" };
+    const t = snap.data() as DeskTicket;
+    const lRef = ledgerRef(ledgerEntryId(["service", ticketId]));
+    const lSnap = await tx.get(lRef);
+
+    if (isSettled(t.status)) {
+      if (t.paystackRef === reference) return { kind: "paid", changed: false };
+      // A different reference already paid this ticket and this one succeeded too: the customer paid twice.
+      if ((t.duplicateRefs ?? []).includes(reference)) return { kind: "duplicate", changed: false };
+      tx.update(ticketRef, { duplicateRefs: FieldValue.arrayUnion(reference), updatedAt: now });
+      return { kind: "duplicate", changed: true };
+    }
+    if (!plan.ok) {
+      if (t.status === "failed" && t.failureReason === AMOUNT_MISMATCH && t.paystackRef === reference) return { kind: "mismatch", changed: false };
+      tx.update(ticketRef, { status: "failed", failureReason: AMOUNT_MISMATCH, paystackRef: reference, updatedAt: now });
+      return { kind: "mismatch", changed: true };
+    }
+    tx.update(ticketRef, {
+      status: "paid", paystackRef: reference, grossMinor: plan.grossMinor, feeMinor: plan.feeMinor,
+      agentMinor: plan.agentMinor, platformMinor: plan.platformMinor, sharePct: plan.sharePct,
+      paidAt: now, updatedAt: now, failureReason: FieldValue.delete(),
+    });
+    if (!lSnap.exists) {
+      tx.create(lRef, buildLedgerDoc({
+        agentId: t.agentId, kind: "service", amountMinor: plan.agentMinor, status: "settled",
+        entityKey: t.entityKey, paystackRef: reference, sourceId: ticketId,
+        grossMinor: plan.grossMinor, feeMinor: plan.feeMinor, sharePct: plan.sharePct, rule: "service",
+        note: `Desk service: ${t.serviceType}`, idempotencyParts: ["service", ticketId],
+      }, now));
+    }
+    return { kind: "paid", changed: true };
+  });
+
+  if (result.kind === "paid" && result.changed) {
+    await audit({
+      action: "ticket_paid", agentId: first.agentId, entityKey: first.entityKey, sessionId: first.sessionId,
+      meta: { ticketId, reference, source, grossMinor: plan.ok ? plan.grossMinor : undefined, feeMinor: plan.ok ? plan.feeMinor : undefined,
+        agentMinor: plan.ok ? plan.agentMinor : undefined, platformMinor: plan.ok ? plan.platformMinor : undefined },
+    });
+  } else if (result.kind === "mismatch" && result.changed) {
+    await audit({
+      action: "ticket_amount_mismatch", agentId: first.agentId, entityKey: first.entityKey,
+      meta: { ticketId, reference, source, expectedMinor: first.amountMinor, receivedMinor: v.amountMinor, currency: currency ?? null },
+    });
+  } else if (result.kind === "duplicate" && result.changed) {
+    await audit({
+      action: "ticket_duplicate_payment", agentId: first.agentId, entityKey: first.entityKey,
+      meta: { ticketId, reference, source, amountMinor: v.amountMinor, note: "The ticket was already paid; this payment needs a manual refund" },
+    });
+  }
+  return result;
+}
+
+/** A confirmed-dead attempt (failed / abandoned / reversed) fails the ticket, but only while that attempt is the live one. */
+export async function failTicketAttempt(
+  args: { ticketId: string; reference: string; reason: string; source: SettleSource },
+  deps: DeskDeps = {},
+): Promise<boolean> {
+  const d = resolveDeps(deps);
+  const ticketRef = col("tickets").doc(args.ticketId);
+  const now = d.now();
+  const changed = await db().runTransaction(async (tx) => {
+    const snap = await tx.get(ticketRef);
+    if (!snap.exists) return undefined;
+    const t = snap.data() as DeskTicket;
+    if (t.status !== "awaiting_payment" || t.paystackRef !== args.reference) return undefined;
+    tx.update(ticketRef, { status: "failed", failureReason: args.reason, updatedAt: now });
+    return t;
+  });
+  if (!changed) return false;
+  await audit({
+    action: "ticket_payment_failed", agentId: changed.agentId, entityKey: changed.entityKey,
+    meta: { ticketId: args.ticketId, reference: args.reference, reason: args.reason, source: args.source },
+  });
+  return true;
+}
diff --git a/functions-desk/src/ledger/trigger.ts b/functions-desk/src/ledger/trigger.ts
new file mode 100644
index 0000000..77dd34c
--- /dev/null
+++ b/functions-desk/src/ledger/trigger.ts
@@ -0,0 +1,57 @@
+/** desk_onCyberTransaction logic: a PAY webhook (or desk) moved a desk charge's cyber-transactions document. */
+import * as logger from "firebase-functions/logger";
+import { parseDeskReference } from "../charge/reference.js";
+import { DEAD_PAYSTACK_STATUSES, isReferenceNotFound, resolveDeps, type DeskDeps } from "../charge/port.js";
+import { DESK_REF_PREFIX } from "../contract.js";
+import { audit } from "../kernel/audit.js";
+import { failTicketAttempt, settleTicketReference } from "./settle.js";
+
+export interface CyberTxData { status?: unknown; deskTicketId?: unknown }
+const FAILURE_STATUSES: ReadonlySet<string> = new Set(["failed", "abandoned"]);
+
+/**
+ * Desk charges only. Success is re-examined on every write (settlement is idempotent, so a replayed webhook is harmless and
+ * a missed first invocation is recoverable); failure only when the status actually changed to it.
+ */
+export function shouldProcessTransactionChange(reference: string, before: CyberTxData | undefined, after: CyberTxData | undefined): boolean {
+  if (!after || !reference.startsWith(DESK_REF_PREFIX)) return false;
+  if (typeof after.deskTicketId !== "string" || after.deskTicketId.length === 0) return false;
+  const status = String(after.status ?? "");
+  if (status === "success") return true;
+  return FAILURE_STATUSES.has(status) && before?.status !== after.status;
+}
+
+export async function handleCyberTransactionChange(
+  reference: string, before: CyberTxData | undefined, after: CyberTxData | undefined, deps: DeskDeps = {},
+): Promise<string> {
+  if (!shouldProcessTransactionChange(reference, before, after)) return "ignored";
+  const d = resolveDeps(deps);
+  const ticketId = String(after!.deskTicketId);
+  const parsed = parseDeskReference(reference);
+  if (!parsed || parsed.ticketId !== ticketId) {
+    await audit({ action: "ticket_reference_rejected", meta: { ticketId, reference, source: "webhook" } });
+    return "rejected";
+  }
+  let verified;
+  try {
+    verified = await d.port.verifyTransaction(reference);
+  } catch (err) {
+    if (isReferenceNotFound(err)) {
+      // the document claims a payment Paystack has never seen: record it, do not retry forever
+      await audit({ action: "cyber_tx_unverifiable", meta: { ticketId, reference, claimed: String(after!.status) } });
+      return "unverifiable";
+    }
+    throw err; // transient: the platform retries this invocation
+  }
+  if (verified.status === "success") {
+    const out = await settleTicketReference({ ticketId, reference, source: "webhook", verified }, d);
+    return out.kind;
+  }
+  if (DEAD_PAYSTACK_STATUSES.has(verified.status)) {
+    const reason = typeof verified.raw.gateway_response === "string" && verified.raw.gateway_response.trim()
+      ? verified.raw.gateway_response.trim() : "Payment was not completed";
+    return (await failTicketAttempt({ ticketId, reference, reason, source: "webhook" }, d)) ? "failed" : "stale";
+  }
+  logger.info("desk charge not final at Paystack yet; the reconciler will settle it", { ticketId, reference, status: verified.status });
+  return "pending";
+}
