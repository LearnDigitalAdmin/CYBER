+import type { RequestActionOtpIn, RequestActionOtpOut, VerifyActionOtpIn, VerifyActionOtpOut } from "../contract.js";
+import { deskCallable } from "../connectors/common.js";
+import { defaultDeps } from "../connectors/deps.js";
+import { HP_SECRETS } from "../kernel/sms.js";
+import { requestActionOtp, verifyActionOtp } from "./handlers.js";
+
+export const desk_requestActionOtp = deskCallable<RequestActionOtpIn, RequestActionOtpOut>(
+  { secrets: HP_SECRETS, timeoutSeconds: 120 },
+  (uid, data) => requestActionOtp(defaultDeps(), uid, data),
+);
+
+export const desk_verifyActionOtp = deskCallable<VerifyActionOtpIn, VerifyActionOtpOut>(
+  {},
+  (uid, data) => verifyActionOtp(defaultDeps(), uid, data),
+);
diff --git a/functions-desk/src/otp/messages.ts b/functions-desk/src/otp/messages.ts
new file mode 100644
index 0000000..e3be847
--- /dev/null
+++ b/functions-desk/src/otp/messages.ts
@@ -0,0 +1,62 @@
+import {
+  EXPORT_KINDS, summaryBulkSms, summaryExport, summaryRentStk, type OtpAction, type Scope,
+} from "../contract.js";
+import { cleanSmsText, SMS_MAX_LENGTH } from "../kernel/sms.js";
+
+export const RENT_STK_MAX_TENANTS = 200;
+export const BULK_SMS_MAX_RECIPIENTS = 1_000_000;
+
+/** Which session scope an action OTP needs. */
+export const ACTION_SCOPE: Record<OtpAction, Scope> = { bulk_sms: "bulk_sms", rent_stk: "rent_stk", export: "export" };
+
+export type SummaryCheck = { ok: true } | { ok: false; message: string };
+
+/**
+ * The summary is what the customer reads in their SMS, so it must be EXACTLY what the contract builders produce.
+ * We parse the variable part and rebuild the string; anything that doesn't round-trip is refused. Pure.
+ */
+export function checkActionSummary(action: OtpAction, summary: unknown): SummaryCheck {
+  const bad: SummaryCheck = { ok: false, message: "The confirmation text does not match the action" };
+  if (typeof summary !== "string") return bad;
+  if (action === "bulk_sms") {
+    const m = /^SMS to (\d{1,7}) recipients$/.exec(summary);
+    const n = m ? Number(m[1]) : 0;
+    return n >= 1 && n <= BULK_SMS_MAX_RECIPIENTS && summary === summaryBulkSms(n) ? { ok: true } : bad;
+  }
+  if (action === "rent_stk") {
+    const m = /^Rent STK to (\d{1,3}) tenants$/.exec(summary);
+    const n = m ? Number(m[1]) : 0;
+    return n >= 1 && n <= RENT_STK_MAX_TENANTS && summary === summaryRentStk(n) ? { ok: true } : bad;
+  }
+  const m = /^Export (\S+)$/.exec(summary);
+  const kind = m ? m[1] : "";
+  return (EXPORT_KINDS as readonly string[]).includes(kind) && summary === summaryExport(kind) ? { ok: true } : bad;
+}
+
+const clip = (s: string, n: number): string => {
+  const t = cleanSmsText(s);
+  return t.length > n ? `${t.slice(0, n - 1).trimEnd()}.` : t;
+};
+
+/** Keeps the code and fixed wording intact: only the names are shortened so the provider's length cap can never cut the OTP. */
+function bounded(build: (agentName: string, entityName: string) => string, agentName: string, entityName: string): string {
+  let a = 40; let e = 50;
+  for (;;) {
+    const msg = build(clip(agentName, a), clip(entityName, e));
+    if (msg.length <= SMS_MAX_LENGTH || (a <= 8 && e <= 8)) return msg;
+    a = Math.max(8, a - 8); e = Math.max(8, e - 8);
+  }
+}
+
+export const accessSmsText = (agentName: string, agentCode: string, entityName: string, otp: string): string =>
+  bounded((a, e) => `Samuhia Desk: ${a} (${agentCode}) asks to access ${e}. Code ${otp}, valid 5 min. Share it ONLY if you asked for help.`,
+    agentName, entityName);
+
+/** Repeats the summary so the customer sees exactly what they are approving. */
+export const actionSmsText = (agentName: string, agentCode: string, summary: string, otp: string): string =>
+  `Samuhia Desk: ${clip(agentName, 40)} (${agentCode}) asks to: ${summary}. Code ${otp}, valid 5 min. Share it ONLY if you asked for help.`;
+
+/** Support confirmation. Deliberately says nothing about money or rewards. */
+export const supportSmsText = (agentName: string, agentCode: string, entityName: string, category: string, code: string): string =>
+  bounded((a, e) => `Samuhia Desk: ${a} (${agentCode}) logged a ${category} support visit for ${e}. Confirmation code ${code}, valid 24 h. Share it ONLY if you received help.`,
+    agentName, entityName);
diff --git a/functions-desk/src/otp/otp.emu.test.ts b/functions-desk/src/otp/otp.emu.test.ts
new file mode 100644
index 0000000..0df6d0d
--- /dev/null
+++ b/functions-desk/src/otp/otp.emu.test.ts
@@ -0,0 +1,77 @@
+import { test, beforeEach } from "node:test";
+import assert from "node:assert/strict";
+import { emulatorEnabled, clearFirestore } from "../testing/emulator.js";
+import { summaryBulkSms, summaryExport } from "../contract.js";
+import { col } from "../db.js";
+import { requireSession } from "../kernel/session.js";
+import { requestActionOtp, verifyActionOtp } from "./handlers.js";
+import { clearChama, entityInfo, harness, lastOtp, openSession, rejects, seedAgent, type Harness } from "../connectors/harness.test.js";
+
+const opts = { skip: !emulatorEnabled };
+const KEY = "chama:SMC-0001";
+let h: Harness; let sid: string;
+beforeEach(async () => {
+  if (!emulatorEnabled) return;
+  await clearFirestore(); await clearChama(); h = harness();
+  await seedAgent("1"); await seedAgent("2");
+  sid = await openSession(h, "1", KEY, ["read", "bulk_sms", "export"]);
+});
+
+test("request SMS repeats the summary and stores only a hash", opts, async () => {
+  const r = await requestActionOtp(h.deps, "1", { sessionId: sid, action: "bulk_sms", summary: summaryBulkSms(25) });
+  const m = h.sms[h.sms.length - 1].message;
+  assert.ok(m.includes("SMS to 25 recipients") && m.includes("valid 5 min"));
+  const a = (await col("actionOtps").doc(r.actionId).get()).data()!;
+  assert.ok(a.otpHash && !JSON.stringify(a).includes(lastOtp(h)));
+  assert.ok(Math.abs(a.otpExpiresAt - (a.createdAt + 5 * 60_000)) < 1000);
+  assert.equal(a.sessionId, sid); assert.equal(a.agentId, "1"); assert.equal(a.action, "bulk_sms");
+});
+test("verify then requireSession consumes it exactly once", opts, async () => {
+  const r = await requestActionOtp(h.deps, "1", { sessionId: sid, action: "export", summary: summaryExport("members") });
+  assert.deepEqual(await verifyActionOtp(h.deps, "1", { actionId: r.actionId, otp: lastOtp(h) }), { ok: true });
+  assert.deepEqual(await verifyActionOtp(h.deps, "1", { actionId: r.actionId, otp: lastOtp(h) }), { ok: true }); // double submit
+  await requireSession({ sessionId: sid, uid: "1", scope: "export", action: "export", actionId: r.actionId });
+  await rejects(requireSession({ sessionId: sid, uid: "1", scope: "export", action: "export", actionId: r.actionId }), "otp_required");
+  await rejects(verifyActionOtp(h.deps, "1", { actionId: r.actionId, otp: lastOtp(h) }), "otp_required", /already used/);
+});
+test("the summary must equal the contract builder's output", opts, async () => {
+  for (const [action, summary] of [["bulk_sms", "SMS to 0 recipients"], ["bulk_sms", "send everything"], ["export", "Export secrets"], ["rent_stk", summaryBulkSms(2)]] as const) {
+    await rejects(requestActionOtp(h.deps, "1", { sessionId: sid, action, summary }), "invalid_argument");
+  }
+  assert.equal((await col("actionOtps").get()).size, 0);
+});
+test("the session must include the action's scope and belong to the agent", opts, async () => {
+  const readOnly = await openSession(h, "1", "chama:SMC-0002", ["read"]);
+  await rejects(requestActionOtp(h.deps, "1", { sessionId: readOnly, action: "bulk_sms", summary: summaryBulkSms(2) }), "permission_denied");
+  await rejects(requestActionOtp(h.deps, "2", { sessionId: sid, action: "bulk_sms", summary: summaryBulkSms(2) }), "permission_denied");
+  await rejects(requestActionOtp(h.deps, "1", { sessionId: sid, action: "refund", summary: "x" }), "invalid_argument");
+});
+test("an authorisation removed by the customer stops new action OTPs", opts, async () => {
+  h.state.delegate = () => entityInfo({ agentAuthorised: false });
+  await rejects(requestActionOtp(h.deps, "1", { sessionId: sid, action: "bulk_sms", summary: summaryBulkSms(2) }), "permission_denied");
+});
+test("wrong codes: 5 attempts then dead, even for the right code", opts, async () => {
+  const r = await requestActionOtp(h.deps, "1", { sessionId: sid, action: "bulk_sms", summary: summaryBulkSms(3) });
+  const good = lastOtp(h); const bad = good === "000000" ? "111111" : "000000";
+  for (let i = 0; i < 4; i++) await rejects(verifyActionOtp(h.deps, "1", { actionId: r.actionId, otp: bad }), "otp_invalid", /not correct/);
+  await rejects(verifyActionOtp(h.deps, "1", { actionId: r.actionId, otp: bad }), "otp_invalid", /Too many/);
+  await rejects(verifyActionOtp(h.deps, "1", { actionId: r.actionId, otp: good }), "otp_invalid");
+});
+test("expired, foreign, unknown and malformed", opts, async () => {
+  const r = await requestActionOtp(h.deps, "1", { sessionId: sid, action: "bulk_sms", summary: summaryBulkSms(3) });
+  await rejects(verifyActionOtp(h.deps, "2", { actionId: r.actionId, otp: lastOtp(h) }), "permission_denied");
+  await rejects(verifyActionOtp(h.deps, "1", { actionId: "nope", otp: "123456" }), "otp_required");
+  await rejects(verifyActionOtp(h.deps, "1", { actionId: r.actionId, otp: "abc" }), "invalid_argument");
+  await col("actionOtps").doc(r.actionId).update({ otpExpiresAt: Date.now() - 1 });
+  await rejects(verifyActionOtp(h.deps, "1", { actionId: r.actionId, otp: lastOtp(h) }), "otp_invalid", /expired/);
+});
+test("an ended session invalidates its pending action OTP", opts, async () => {
+  const r = await requestActionOtp(h.deps, "1", { sessionId: sid, action: "bulk_sms", summary: summaryBulkSms(3) });
+  await col("sessions").doc(sid).update({ status: "ended" });
+  await rejects(verifyActionOtp(h.deps, "1", { actionId: r.actionId, otp: lastOtp(h) }), "session_invalid");
+});
+test("SMS failure deletes the OTP and says so", opts, async () => {
+  h.state.smsFails = true;
+  await rejects(requestActionOtp(h.deps, "1", { sessionId: sid, action: "bulk_sms", summary: summaryBulkSms(3) }), "internal", /could not send/);
+  assert.equal((await col("actionOtps").get()).size, 0);
+});
diff --git a/functions-desk/src/otp/otp.test.ts b/functions-desk/src/otp/otp.test.ts
new file mode 100644
index 0000000..db7e48b
--- /dev/null
+++ b/functions-desk/src/otp/otp.test.ts
@@ -0,0 +1,67 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { evaluateOtpAttempt, hashOtp, isOtpShape, otpMatches, wrongCodeMessage } from "./core.js";
+import { accessSmsText, actionSmsText, checkActionSummary, supportSmsText } from "./messages.js";
+import { summaryBulkSms, summaryExport, summaryRentStk, EXPORT_KINDS } from "../contract.js";
+import { SMS_MAX_LENGTH } from "../kernel/sms.js";
+import { randomOtp } from "../connectors/deps.js";
+
+const NOW = 1_700_000_000_000;
+const state = (o = {}) => ({ hash: hashOtp("123456", "id1"), attempts: 0, expiresAt: NOW + 1000, ...o });
+
+test("otp shape is exactly six digits", () => {
+  assert.ok(isOtpShape("012345")); assert.ok(!isOtpShape("12345")); assert.ok(!isOtpShape("1234567")); assert.ok(!isOtpShape(123456)); assert.ok(!isOtpShape("12345a"));
+});
+test("randomOtp is six digits", () => { for (let i = 0; i < 200; i++) assert.match(randomOtp(), /^\d{6}$/); });
+test("hash binds the id and matches in constant time", () => {
+  assert.ok(otpMatches(hashOtp("123456", "id1"), "123456", "id1"));
+  assert.ok(!otpMatches(hashOtp("123456", "id1"), "123456", "id2"));
+  assert.ok(!otpMatches(hashOtp("123456", "id1"), "654321", "id1"));
+  assert.ok(!otpMatches(undefined, "123456", "id1"));
+  assert.ok(!otpMatches("short", "123456", "id1"));
+});
+test("correct code succeeds and counts the attempt", () => assert.deepEqual(evaluateOtpAttempt(state(), "123456", "id1", NOW), { kind: "ok", attempts: 1 }));
+test("wrong code counts; the 5th wrong locks", () => {
+  assert.deepEqual(evaluateOtpAttempt(state(), "000000", "id1", NOW), { kind: "wrong", attempts: 1, locked: false });
+  assert.deepEqual(evaluateOtpAttempt(state({ attempts: 4 }), "000000", "id1", NOW), { kind: "wrong", attempts: 5, locked: true });
+});
+test("a correct code on the 5th try still works; after 5 it is locked", () => {
+  assert.equal(evaluateOtpAttempt(state({ attempts: 4 }), "123456", "id1", NOW).kind, "ok");
+  assert.equal(evaluateOtpAttempt(state({ attempts: 5 }), "123456", "id1", NOW).kind, "locked");
+});
+test("expired code is refused", () => assert.equal(evaluateOtpAttempt(state({ expiresAt: NOW }), "123456", "id1", NOW).kind, "expired"));
+test("wrong-code message counts tries left", () => {
+  assert.match(wrongCodeMessage({ kind: "wrong", attempts: 4, locked: false }, "access code"), /1 try left/);
+  assert.match(wrongCodeMessage({ kind: "wrong", attempts: 5, locked: true }, "access code"), /new access code/);
+});
+
+test("action summaries must equal the contract builders exactly", () => {
+  assert.ok(checkActionSummary("bulk_sms", summaryBulkSms(25)).ok);
+  assert.ok(checkActionSummary("rent_stk", summaryRentStk(200)).ok);
+  for (const k of EXPORT_KINDS) assert.ok(checkActionSummary("export", summaryExport(k)).ok);
+  assert.ok(!checkActionSummary("bulk_sms", "SMS to 007 recipients").ok);
+  assert.ok(!checkActionSummary("bulk_sms", "SMS to 0 recipients").ok);
+  assert.ok(!checkActionSummary("bulk_sms", summaryBulkSms(5) + " ").ok);
+  assert.ok(!checkActionSummary("rent_stk", summaryRentStk(201)).ok);
+  assert.ok(!checkActionSummary("rent_stk", summaryBulkSms(5)).ok);
+  assert.ok(!checkActionSummary("export", "Export everything").ok);
+  assert.ok(!checkActionSummary("export", 5).ok);
+});
+
+test("access SMS has the agreed wording and the code survives very long names", () => {
+  const m = accessSmsText("Jane W", "COG-0001", "Umoja Chama", "482913");
+  assert.equal(m, "Samuhia Desk: Jane W (COG-0001) asks to access Umoja Chama. Code 482913, valid 5 min. Share it ONLY if you asked for help.");
+  const long = accessSmsText("A".repeat(80), "COG-12345", "B".repeat(400), "482913");
+  assert.ok(long.length <= SMS_MAX_LENGTH);
+  assert.ok(long.includes("Code 482913, valid 5 min. Share it ONLY if you asked for help."));
+});
+test("action SMS repeats the summary", () => {
+  const m = actionSmsText("Jane", "COG-0001", summaryBulkSms(25), "111222");
+  assert.ok(m.includes(summaryBulkSms(25)) && m.includes("Code 111222"));
+  assert.ok(m.length <= SMS_MAX_LENGTH);
+});
+test("support SMS never mentions rewards or money", () => {
+  const m = supportSmsText("Jane", "COG-0001", "Umoja Chama", "training", "333444");
+  assert.ok(m.includes("333444"));
+  assert.doesNotMatch(m, /reward|bonus|commission|earn|pay|KES|ksh/i);
+});
diff --git a/functions-desk/src/sessions/access.ts b/functions-desk/src/sessions/access.ts
new file mode 100644
index 0000000..99ff77e
--- /dev/null
+++ b/functions-desk/src/sessions/access.ts
@@ -0,0 +1,171 @@
+import {
+  DESK_TOP_CODE, type EndSessionOut, type EntityKey, type RequestAccessOut, type VerifyAccessOut,
+} from "../contract.js";
+import { FieldValue } from "firebase-admin/firestore";
+import { col, db } from "../db.js";
+import { DeskError } from "../errors.js";
+import { audit } from "../kernel/audit.js";
+import { requireActiveAgent } from "../kernel/agents.js";
+import { maskPhone } from "../paystack/phone.js";
+import type { AgentDoc, CustomerDoc, SessionDoc } from "../types.js";
+import type { Deps } from "../connectors/deps.js";
+import { writeDeskOwner } from "../connectors/deskOwner.js";
+import {
+  adminPhoneE164, assertEntityKey, customerDocId, isSameNumber, lookupEntity, NOT_AUTHORISED_MESSAGE,
+} from "../connectors/entities.js";
+import { record } from "../connectors/input.js";
+import {
+  accessHourRule, entityDailyRule, evaluateOtpAttempt, hashOtp, isOtpShape, OTP_TTL_MS, SESSION_TTL_MS, takeRates, wrongCodeMessage,
+} from "../otp/core.js";
+import { accessSmsText } from "../otp/messages.js";
+import { validateScopes } from "./pure.js";
+
+export async function requestAccess(deps: Deps, uid: string, raw: unknown): Promise<RequestAccessOut> {
+  const d = record(raw);
+  const agent = await requireActiveAgent(uid);
+  const entity = assertEntityKey(typeof d.entityKey === "string" ? d.entityKey : "");
+  const scopes = validateScopes(d.scopes);
+
+  const cfg = await deps.getConfig();
+  const lookup = await lookupEntity(deps, cfg, agent, entity.product, entity.code);
+  if (!lookup.authorised) throw new DeskError("permission_denied", NOT_AUTHORISED_MESSAGE);
+  const adminPhone = adminPhoneE164(lookup.info);
+  if (isSameNumber(agent.phone, adminPhone)) {
+    throw new DeskError("permission_denied", "You cannot open a session on an account you administer yourself");
+  }
+
+  const taken = await takeRates([accessHourRule(uid, entity.entityKey), entityDailyRule(entity.entityKey)], deps.now());
+
+  // Older unverified codes for this desk and customer stop being usable.
+  const stale = await col("sessions").where("agentId", "==", uid).where("entityKey", "==", entity.entityKey).where("status", "==", "pending").get();
+  if (!stale.empty) {
+    const batch = db().batch();
+    for (const s of stale.docs) batch.update(s.ref, { status: "ended" });
+    await batch.commit();
+  }
+
+  const ref = col("sessions").doc();
+  const otp = deps.randomOtp();
+  const now = deps.now();
+  const doc: SessionDoc = {
+    sessionId: ref.id, agentId: uid, entityKey: entity.entityKey, scopes, status: "pending",
+    otpHash: hashOtp(otp, ref.id), otpAttempts: 0, otpExpiresAt: now + OTP_TTL_MS, expiresAt: now + OTP_TTL_MS, createdAt: now,
+  };
+  await ref.create(doc);
+  try {
+    await deps.sendSms(adminPhone, accessSmsText(agent.name, agent.agentCode, lookup.info.displayName, otp));
+  } catch {
+    await ref.delete().catch(() => undefined);
+    await taken.release();
+    throw new DeskError("internal", "We could not send the access code to the customer. Please try again.");
+  }
+  await audit({ action: "access_requested", agentId: uid, entityKey: entity.entityKey, sessionId: ref.id, meta: { scopes } });
+  return { sessionId: ref.id, otpSentTo: maskPhone(adminPhone) };
+}
+
+type VerifyOutcome =
+  | { kind: "ok"; expiresAt: number; claimed: boolean; already: boolean; entityKey: EntityKey }
+  | { kind: "missing" } | { kind: "foreign" } | { kind: "agent" } | { kind: "inactive" }
+  | { kind: "expired" } | { kind: "locked" } | { kind: "wrong"; attempts: number; locked: boolean };
+
+export async function verifyAccess(deps: Deps, uid: string, raw: unknown): Promise<VerifyAccessOut> {
+  const d = record(raw);
+  const sessionId = typeof d.sessionId === "string" ? d.sessionId : "";
+  if (!sessionId) throw new DeskError("invalid_argument", "Session is required");
+  if (!isOtpShape(d.otp)) throw new DeskError("invalid_argument", "Enter the 6-digit code");
+  const otp = (d.otp as string).trim();
+  const now = deps.now();
+  const sRef = col("sessions").doc(sessionId);
+
+  const out = await db().runTransaction(async (tx): Promise<VerifyOutcome> => {
+    const sSnap = await tx.get(sRef);
+    if (!sSnap.exists) return { kind: "missing" };
+    const s = sSnap.data() as SessionDoc;
+    if (s.agentId !== uid) return { kind: "foreign" };
+    const aSnap = await tx.get(col("agents").doc(uid));
+    const agent = aSnap.exists ? (aSnap.data() as AgentDoc) : undefined;
+    if (!agent || agent.status !== "active") return { kind: "agent" };
+    const cRef = col("customers").doc(customerDocId(s.entityKey));
+    const cSnap = await tx.get(cRef); // every read happens before the first write
+    if (s.status === "active" && s.otpVerifiedAt && s.expiresAt > now) {
+      return { kind: "ok", expiresAt: s.expiresAt, claimed: false, already: true, entityKey: s.entityKey };
+    }
+    if (s.status !== "pending") return { kind: "inactive" };
+
+    const r = evaluateOtpAttempt({ hash: s.otpHash, attempts: s.otpAttempts, expiresAt: s.otpExpiresAt }, otp, sessionId, now);
+    if (r.kind === "locked") { tx.update(sRef, { status: "ended" }); return { kind: "locked" }; }
+    if (r.kind === "expired") { tx.update(sRef, { status: "expired" }); return { kind: "expired" }; }
+    if (r.kind === "wrong") {
+      tx.update(sRef, r.locked ? { otpAttempts: r.attempts, status: "ended" } : { otpAttempts: r.attempts });
+      return r;
+    }
+
+    const expiresAt = now + SESSION_TTL_MS;
+    tx.update(sRef, { status: "active", otpVerifiedAt: now, expiresAt, otpAttempts: r.attempts, otpHash: FieldValue.delete() });
+
+    // Ownership claim, same transaction: first verified desk wins, an existing owner is never replaced, COG-0000 never claims.
+    let claimed = false;
+    if (!cSnap.exists && agent.agentCode !== DESK_TOP_CODE) {
+      const customer: CustomerDoc = {
+        entityKey: s.entityKey, product: assertEntityKey(s.entityKey).product, ownerAgentId: uid, attributedAt: now,
+        selfOwned: false, firstPurchaseUsed: false, paidPeriods: [],
+      };
+      tx.create(cRef, customer);
+      claimed = true;
+    }
+    return { kind: "ok", expiresAt, claimed, already: false, entityKey: s.entityKey };
+  });
+
+  switch (out.kind) {
+    case "ok": break;
+    case "missing": throw new DeskError("session_invalid", "Session not found");
+    case "foreign": throw new DeskError("permission_denied", "This session belongs to another agent");
+    case "agent": throw new DeskError("permission_denied", "Your desk account is not active");
+    case "inactive": throw new DeskError("session_invalid", "This session is no longer waiting for a code. Request access again.");
+    case "expired": throw new DeskError("otp_invalid", "This code has expired. Request access again.");
+    case "locked": throw new DeskError("otp_invalid", "Too many wrong codes. Request access again.");
+    case "wrong": throw new DeskError("otp_invalid", wrongCodeMessage(out, "access code"));
+  }
+
+  if (!out.already) {
+    await audit({ action: "access_verified", agentId: uid, entityKey: out.entityKey, sessionId, meta: { claimed: out.claimed } });
+    if (out.claimed) {
+      await audit({ action: "ownership_claimed", agentId: uid, entityKey: out.entityKey, sessionId });
+      const { product, code } = assertEntityKey(out.entityKey);
+      if (product === "chama") await pushDeskOwner(deps, uid, code, sessionId, out.entityKey);
+    }
+  }
+  return { expiresAt: out.expiresAt };
+}
+
+/** Ownership is already committed; a failed write must not fail the verification. desk_syncPayoutAccounts retries it. */
+async function pushDeskOwner(deps: Deps, uid: string, chamaCode: string, sessionId: string, entityKey: EntityKey): Promise<void> {
+  let reason: string | undefined;
+  try {
+    const agent = (await col("agents").doc(uid).get()).data() as AgentDoc;
+    const r = await writeDeskOwner(deps, await deps.getConfig(), agent, chamaCode);
+    if (!r.written) reason = r.reason;
+  } catch (err) {
+    reason = err instanceof DeskError ? err.message : "The MyChama update failed";
+  }
+  if (reason) await audit({ action: "desk_owner_pending", agentId: uid, entityKey, sessionId, meta: { reason } });
+}
+
+export async function endSession(deps: Deps, uid: string, raw: unknown): Promise<EndSessionOut> {
+  const d = record(raw);
+  const sessionId = typeof d.sessionId === "string" ? d.sessionId : "";
+  if (!sessionId) throw new DeskError("invalid_argument", "Session is required");
+  const ref = col("sessions").doc(sessionId);
+  const out = await db().runTransaction(async (tx) => {
+    const snap = await tx.get(ref);
+    if (!snap.exists) return { kind: "missing" as const };
+    const s = snap.data() as SessionDoc;
+    if (s.agentId !== uid) return { kind: "foreign" as const };
+    if (s.status === "pending" || s.status === "active") { tx.update(ref, { status: "ended", endedAt: deps.now() }); return { kind: "ended" as const, entityKey: s.entityKey }; }
+    return { kind: "already" as const };
+  });
+  if (out.kind === "missing") throw new DeskError("session_invalid", "Session not found");
+  if (out.kind === "foreign") throw new DeskError("permission_denied", "This session belongs to another agent");
+  if (out.kind === "ended") await audit({ action: "session_ended", agentId: uid, entityKey: out.entityKey, sessionId });
+  return { ok: true };
+}
