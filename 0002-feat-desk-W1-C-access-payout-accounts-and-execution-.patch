@@ -0,0 +1,45 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { formatAgentCode, hashIdNumber, maskIdNumber, nextCounterValue, validateApplication } from "./pure.js";
+
+const ok = { name: "Jane Wanjiru", phone: "0712345678", idNumber: "12345678", wardId: "ward-1" };
+const bad = (o: Record<string, unknown>) => () => validateApplication({ ...ok, ...o });
+
+test("valid application is normalised", () => {
+  const a = validateApplication({ ...ok, name: "  Jane Wanjiru ", idNumber: "1234 5678" });
+  assert.equal(a.name, "Jane Wanjiru");
+  assert.equal(a.phone, "+254712345678");
+  assert.equal(a.idNumber, "12345678");
+});
+test("name 2–80", () => { assert.throws(bad({ name: "J" })); assert.throws(bad({ name: "x".repeat(81) })); assert.doesNotThrow(bad({ name: "Jo" })); });
+test("ID number 6–12 digits only", () => {
+  assert.throws(bad({ idNumber: "12345" })); assert.throws(bad({ idNumber: "1".repeat(13) })); assert.throws(bad({ idNumber: "12345A78" }));
+  assert.doesNotThrow(bad({ idNumber: "123456" })); assert.doesNotThrow(bad({ idNumber: "1".repeat(12) }));
+});
+test("ward 1–40", () => { assert.throws(bad({ wardId: "" })); assert.throws(bad({ wardId: "w".repeat(41) })); });
+test("phone must be Kenyan", () => assert.throws(bad({ phone: "123" })));
+test("non-object input is refused", () => assert.throws(() => validateApplication(null)));
+
+test("agent code pads to 4 digits and never issues COG-0000", () => {
+  assert.equal(formatAgentCode(1), "COG-0001");
+  assert.equal(formatAgentCode(42), "COG-0042");
+  assert.equal(formatAgentCode(12345), "COG-12345");
+  assert.throws(() => formatAgentCode(0));
+  assert.throws(() => formatAgentCode(-3));
+  assert.throws(() => formatAgentCode(1.5));
+});
+test("counter starts at 1 and ignores damaged values", () => {
+  assert.equal(nextCounterValue(undefined), 1);
+  assert.equal(nextCounterValue(0), 1);
+  assert.equal(nextCounterValue(7), 8);
+  assert.equal(nextCounterValue(-5), 1);
+  assert.equal(nextCounterValue("9"), 1);
+});
+test("id hash is salted, stable and not the number", () => {
+  const h = hashIdNumber("12345678", "salt-a");
+  assert.equal(h, hashIdNumber("12345678", "salt-a"));
+  assert.notEqual(h, hashIdNumber("12345678", "salt-b"));
+  assert.match(h, /^[0-9a-f]{64}$/);
+  assert.ok(!h.includes("12345678"));
+});
+test("mask keeps last 4", () => assert.equal(maskIdNumber("12345678"), "****5678"));
diff --git a/functions-desk/src/agents/pure.ts b/functions-desk/src/agents/pure.ts
new file mode 100644
index 0000000..a253892
--- /dev/null
+++ b/functions-desk/src/agents/pure.ts
@@ -0,0 +1,36 @@
+import { createHash } from "node:crypto";
+import { DESK_CODE_PREFIX } from "../contract.js";
+import { DeskError } from "../errors.js";
+import { normalizeKenyaPhone } from "../paystack/phone.js";
+import { record, text } from "../connectors/input.js";
+
+export interface ApplicationFields { name: string; phone: string; idNumber: string; wardId: string }
+
+/** Validates and normalises an application. Phone becomes +254…; ID number is digits only. Pure. */
+export function validateApplication(raw: unknown): ApplicationFields {
+  const d = record(raw);
+  const name = text(d.name, "Name", 2, 80);
+  const wardId = text(d.wardId, "Ward", 1, 40);
+  const phone = normalizeKenyaPhone(typeof d.phone === "string" ? d.phone : "");
+  const idNumber = typeof d.idNumber === "string" ? d.idNumber.replace(/\s+/g, "") : "";
+  if (!/^\d{6,12}$/.test(idNumber)) throw new DeskError("invalid_argument", "ID number must be 6–12 digits");
+  return { name, phone, idNumber, wardId };
+}
+
+/** COG-0001, COG-0002 … at least 4 digits. COG-0000 is the company's top desk and is never issued. */
+export function formatAgentCode(n: number): string {
+  if (!Number.isSafeInteger(n) || n < 1) throw new DeskError("internal", "Invalid desk number");
+  return `${DESK_CODE_PREFIX}${String(n).padStart(4, "0")}`;
+}
+
+/** Next number from the stored counter: the counter holds the LAST issued number, so a fresh or damaged one yields 1. */
+export function nextCounterValue(stored: unknown): number {
+  const n = typeof stored === "number" && Number.isSafeInteger(stored) && stored >= 0 ? stored : 0;
+  return n + 1;
+}
+
+/** Salted SHA-256 of the ID number. Never store the number itself. */
+export const hashIdNumber = (idNumber: string, salt: string): string =>
+  createHash("sha256").update(`${salt}:${idNumber}`).digest("hex");
+
+export const maskIdNumber = (idNumber: string): string => `****${idNumber.slice(-4)}`;
diff --git a/functions-desk/src/connectors/common.ts b/functions-desk/src/connectors/common.ts
new file mode 100644
index 0000000..def6392
--- /dev/null
+++ b/functions-desk/src/connectors/common.ts
@@ -0,0 +1,28 @@
+import { HttpsError, onCall, type CallableRequest } from "firebase-functions/v2/https";
+import { defineSecret } from "firebase-functions/params";
+type SecretParam = ReturnType<typeof defineSecret>;
+import { DeskError, httpsCodeFor } from "../errors.js";
+
+export interface CallableOptions { secrets?: SecretParam[]; timeoutSeconds?: number }
+type AuthToken = NonNullable<CallableRequest["auth"]>["token"];
+
+/**
+ * Wraps a handler as a callable: requires sign-in, maps DeskError to the right HttpsError and never leaks internals.
+ * Handlers get the caller's uid and Auth token; privileges are enforced inside them (requireActiveAgent / requireSession).
+ */
+export function deskCallable<I, O>(
+  opts: CallableOptions,
+  handler: (uid: string, data: I, token: AuthToken) => Promise<O>,
+) {
+  return onCall({ secrets: opts.secrets ?? [], timeoutSeconds: opts.timeoutSeconds ?? 60 }, async (req: CallableRequest<I>) => {
+    if (!req.auth) throw new HttpsError("unauthenticated", "Please sign in");
+    try {
+      return await handler(req.auth.uid, req.data, req.auth.token);
+    } catch (err) {
+      if (err instanceof HttpsError) throw err;
+      if (err instanceof DeskError) throw new HttpsError(httpsCodeFor(err.code), err.message);
+      console.error("desk callable failed", err);
+      throw new HttpsError("internal", "Something went wrong. Please try again.");
+    }
+  });
+}
