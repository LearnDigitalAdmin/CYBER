+  assert.throws(() => validateTenantIds(["a/b"], 200));
+  assert.throws(() => validateTenantIds([""], 200));
+  assert.throws(() => validateTenantIds(Array.from({ length: 201 }, (_, i) => `t${i}`), 200));
