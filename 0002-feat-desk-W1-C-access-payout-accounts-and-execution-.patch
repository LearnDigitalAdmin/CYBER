+  const r = await requestActionOtp(h.deps, "1", { sessionId: sid, action: "rent_stk", summary: summaryRentStk(2) });
+  await rejects(initiateRentStk(h.deps, "1", { sessionId: sid, actionId: r.actionId, tenantIds: ids(2) }), "otp_required");
