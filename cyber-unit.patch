+          unitSize: normalizeUnitSize(u.unitSize),
+          condition: normalizeUnitCondition(u.condition)
+        } as Unit;
+      })
+      .sort((a, b) => a.unitNumber.localeCompare(b.unitNumber, undefined, { numeric: true }));
